{
  "name": "@yakult001/monitor-report",
  "version": "0.2.0",
  "description": "前端监控组件：错误 / 性能 / 网络 / 内存各维度采集与上报",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "import": "./dist/error.js",
      "require": "./dist/error.cjs"
    },
    "./performance": {
      "types": "./dist/performance.d.ts",
      "import": "./dist/performance.js",
      "require": "./dist/performance.cjs"
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "import": "./dist/network.js",
      "require": "./dist/network.cjs"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "require": "./dist/memory.cjs"
    },
    "./vue3": {
      "types": "./dist/vue3.d.ts",
      "import": "./dist/vue3.js",
      "require": "./dist/vue3.cjs"
    },
    "./vue2": {
      "types": "./dist/vue2.d.ts",
      "import": "./dist/vue2.js",
      "require": "./dist/vue2.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run ci",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "verify:dist": "node scripts/verify-dist.mjs",
    "ci": "npm run lint && npm run typecheck && npm run check:entries && npm run test && npm run build && npm run verify:dist && npm run size",
    "gen:entries": "node scripts/gen-entries.mjs",
    "check:entries": "node scripts/gen-entries.mjs --check"
  },
  "keywords": [
    "monitor",
    "report",
    "error",
    "performance",
    "frontend"
  ],
  "license": "MIT",
  "author": "yakult001",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1Egbert1/monitor-report.git"
  },
  "homepage": "https://github.com/1Egbert1/monitor-report#readme",
  "bugs": {
    "url": "https://github.com/1Egbert1/monitor-report/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@size-limit/preset-small-lib": "^11.1.4",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.0",
    "happy-dom": "^15.0.0",
    "husky": "^9.1.1",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "size-limit": "^11.1.4",
    "tsup": "^8.2.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
